@startuml
title Calculator TCP service — request sequence
autonumber

actor Client
participant main
participant SignalHandler
participant "io_context" as IO
participant Server
participant Session
participant RequestHandler as Handler
participant Parser
participant Calculator
participant Repository
participant Cache
participant Transaction
database Database
participant "toResponse()" as Response

== Startup ==
main -> SignalHandler : start(onShutdown)
note over SignalHandler : dedicated thread\nblocks on sigwait()
main -> Repository : construct (warm up cache)
activate Repository
Repository -> Transaction : fetchAll(callback)
Transaction -> Database : SELECT tasks
Database --> Transaction : rows
loop each task
  Transaction -> Cache : insert(task)
end
deactivate Repository
main -> Server : listen(port)
main -> IO : run()
activate IO

== New connection ==
Client -> Server : connect
Server -> Session : create + start()

== Request flow (repeats per line) ==
loop until client disconnects
  Client -> Session : request line (JSON)
  Session -> Handler : handle(json)
  activate Handler

  Handler -> Parser : parse(json)
  Parser --> Handler : Request

  Handler -> Repository : get(Request)
  Repository -> Cache : get(Request)

  alt cache hit
      Cache --> Repository : Task
      Repository --> Handler : Task
  else cache miss
      Cache --> Repository : nullopt
      Repository --> Handler : nullopt
      Handler -> Calculator : calculate(Request)
      Calculator --> Handler : Task
      Handler -> Repository : save(Task)
      Repository -> Transaction : record(Task) + commit()
      Transaction -> Database : INSERT + COMMIT
      Repository -> Cache : insert(Task)
  end

  Handler -> Response : toResponse(Task)
  Response --> Handler : response line
  note over Handler : parse/compute errors are\ncaught and returned as "Error: ...\\n"
  deactivate Handler
  Session --> Client : response line
end

== Shutdown ==
[-> SignalHandler : SIGTERM / SIGINT
SignalHandler -> IO : stop()
IO --> main : run() returns
deactivate IO
main -> main : graceful exit
@enduml
